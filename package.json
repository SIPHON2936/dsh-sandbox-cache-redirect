{
  "name": "dsh-sandbox-cache-redirect",
  "version": "7.0.0-rc.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Siphon2673/dsh-sandbox-cache-redirect.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "sandbox",
    "bwrap",
    "uv",
    "cache"
  ],
  "description": "Pluggable cache redirect for the native local sandbox provider: injects nine uv/pip/npm/Go cache/runtime environment options into the native bwrap argv for Linux workspace-write calls. No external runner; disabling or uninstalling restores the native provider. Linux enhancement only.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "AGENTS.md",
    "index.js",
    "lib/*.js",
    "cordis.patch.yml",
    "tools/session-check.py",
    "tools/bundle-selection.mjs",
    "tests/*.mjs",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/dsh-sandbox": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-sandbox-local": "0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox-local": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
