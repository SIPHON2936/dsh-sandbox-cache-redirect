{
  "name": "dsh-sandbox-cache-redirect",
  "version": "6.3.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Siphon2673/dsh-sandbox-cache-redirect.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "sandbox",
    "bwrap",
    "uv",
    "cache"
  ],
  "description": "Guarded sandbox provider that pins a digest-verified bwrap runner, redirecting uv/pip/npm/Go caches and runtimes into the workspace for sandboxed commands (V6.2 scheme). Linux only.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "AGENTS.md",
    "index.js",
    "lib/*.js",
    "cordis.patch.yml",
    "patches/*.yml",
    "runner/dsh-bwrap-redirect",
    "tools/*.py",
    "tests/*.mjs",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/dsh-sandbox": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-sandbox-local": "0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox-local": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
