{
  "name": "dsh-sandbox-cache-redirect",
  "version": "6.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SIPHON2936/dsh-sandbox-cache-redirect.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "sandbox",
    "bwrap",
    "uv",
    "cache"
  ],
  "description": "Redirects uv/pip/npm/Go cache and runtime directories into the workspace for sandboxed commands, via a pinned bwrap runner (V6.2 scheme).",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "runner/dsh-bwrap-redirect",
    "tools/*.py",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
